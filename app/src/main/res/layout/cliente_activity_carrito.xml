<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ENCABEZADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/flecha_pequena_izquierda" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mi carrito"
                    android:textColor="#6A4C93"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/basura_roja" />

            </LinearLayout>

            <!-- PRODUCTO 1 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/naruto"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:text="Naruto Amigurumi"
                            android:textColor="#6A4C93"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="$55.000"
                            android:textColor="#D46AA7"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <!--Selectror de cantidad-->

                        <LinearLayout
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:background="@drawable/selector_cantidad"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Botón Restar -->

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnMenosCarrito"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="-"
                                android:textColor="#7D6BB2"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <!-- Divisor -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:background="#A6A6A6" />

                            <!-- Cantidad -->
                            <TextView
                                android:id="@+id/txtCantidadCarrito"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <!-- Divisor -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:background="#A6A6A6" />

                            <!-- Botón Sumar -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnSumarCarrito"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="+"
                                android:textColor="#7D6BB2"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/basura"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PRODUCTO 2 -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/gerberas"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:text="Gerberas"
                            android:textColor="#6A4C93"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="$35.000"
                            android:textColor="#D46AA7"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <!--Selectror de cantidad-->

                        <LinearLayout
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:background="@drawable/selector_cantidad"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Botón Restar -->

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnMenos"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="-"
                                android:textColor="#7D6BB2"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <!-- Divisor -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:background="#A6A6A6" />

                            <!-- Cantidad -->
                            <TextView
                                android:id="@+id/txtCantidad"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="#000000"
                                android:textSize="16sp" />

                            <!-- Divisor -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="20dp"
                                android:background="#A6A6A6" />

                            <!-- Botón Sumar -->
                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnSumar"
                                android:layout_width="40dp"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="+"
                                android:textColor="#7D6BB2"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/basura"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- RESUMEN -->

            <TextView
                android:id="@+id/txtSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Subtotal                     $90.000"
                android:textColor="#6A4C93"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Envío                          $10.000"
                android:textColor="#6A4C93"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Total                          $100.000"
                android:textColor="#6A4C93"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- BOTON -->

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#9B7AE0"
                android:text="Proceder al pago"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/carrito_de_compras"
                app:iconGravity="textEnd"
                app:iconPadding="12dp"
                app:iconTint="@null" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="60dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#9B7AE0"
        app:itemTextColor="#9B7AE0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>