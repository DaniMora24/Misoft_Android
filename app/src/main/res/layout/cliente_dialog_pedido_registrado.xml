<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- ICONO DE ÉXITO -->
    <androidx.cardview.widget.CardView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center_horizontal"
        app:cardCornerRadius="38dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3EAFE">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✓"
            android:textColor="#8E6AD8"
            android:textSize="38sp"
            android:textStyle="bold"
            android:contentDescription="Pedido registrado correctamente"/>

    </androidx.cardview.widget.CardView>

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtTituloPedidoExito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="¡Pedido registrado!"
        android:textColor="#6A4C93"
        android:textSize="23sp"
        android:textStyle="bold"/>

    <!-- SUBTÍTULO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tu pedido fue registrado correctamente"
        android:textColor="#888888"
        android:textSize="14sp"/>

    <!-- TARJETA RESUMEN DEL PEDIDO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFF7FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- NÚMERO DEL PEDIDO -->
            <TextView
                android:id="@+id/txtPedidoNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido #0"
                android:textColor="#6A4C93"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- DIVISOR -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#EADBE7"/>

            <!-- MÉTODO DE PAGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Método de pago"
                    android:textColor="#888888"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtPedidoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pago: Contraentrega"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- ESTADO DEL PEDIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado del pedido"
                    android:textColor="#888888"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtPedidoEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Estado: Pendiente"
                    android:textColor="#9A6700"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- MENSAJE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Pagarás cuando recibas tu pedido."
                android:textColor="#777777"
                android:textSize="13sp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- INFORMACIÓN ADICIONAL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Puedes consultar el estado de tu pedido en el historial de compras."
        android:textColor="#777777"
        android:textSize="13sp"/>

    <!-- BOTÓN VER MIS COMPRAS -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerCompras"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Ver mis compras"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:contentDescription="Ver historial de compras"
        app:backgroundTint="#8E6AD8"
        app:cornerRadius="27dp"/>

    <!-- BOTÓN ACEPTAR -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAceptarPedido"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Aceptar"
        android:textColor="#8E6AD8"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#F3EAFE"
        app:cornerRadius="25dp"/>

</LinearLayout>
