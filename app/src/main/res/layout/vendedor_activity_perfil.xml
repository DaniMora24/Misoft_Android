<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationSeller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TÍTULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mi perfil"
                android:textColor="#6A4C93"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administra tu cuenta de vendedor"
                android:textColor="#888888"
                android:textSize="14sp"/>

            <!-- TARJETA DE PERFIL -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <FrameLayout
                        android:id="@+id/contenedorFotoPerfilVendedor"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Cambiar foto de perfil">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgPerfilTienda"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/usuario"
                            android:contentDescription="Foto del vendedor"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"/>

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="bottom|end"
                            android:background="#F6EFFF"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="Seleccionar fotografía"
                            app:tint="#6A4C93"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtNombreTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="Cargando nombre..."
                        android:textColor="#6A4C93"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtCorreoTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Cargando correo..."
                        android:textColor="#777777"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/txtCambiarFotoVendedor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:padding="8dp"
                        android:text="📷 Cambiar fotografía"
                        android:textColor="#8E6AD8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- OPCIONES DE PERFIL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Mi cuenta"
                android:textColor="#6A4C93"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <!-- INFORMACIÓN PERSONAL -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfoCuentaVendedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="25sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Información de la cuenta"
                            android:textColor="#6A4C93"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Nombre y correo registrados"
                            android:textColor="#888888"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ESTADÍSTICAS -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEstadisticasPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:text="📊"
                        android:textSize="25sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mis estadísticas"
                            android:textColor="#6A4C93"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Consulta las ventas de tu tienda"
                            android:textColor="#888888"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/angulo_derecho"
                        android:contentDescription="Ver estadísticas"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CERRAR SESIÓN -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesionVendedor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#9B7AE0"
                app:cornerRadius="18dp"
                app:icon="@drawable/cierre_usuario"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="#FFFFFF"
                app:iconSize="22dp"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ INFERIOR -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationSeller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_menu_vendedor"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="#9B7AE0"
        app:itemTextColor="#9B7AE0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
