<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="#FFF7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- INDICADOR DEL BOTTOM SHEET -->

        <View
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#D3D3D3"/>

        <!-- ENCABEZADO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Detalle del pedido"
            android:textColor="#6A4C93"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetalleNumeroPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Pedido #"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtDetalleFechaPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Fecha del pedido"
            android:textColor="#777777"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txtDetalleEstadoPedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFF3CD"
            android:background="@android:drawable/editbox_background"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="Pendiente"
            android:textColor="#A66C00"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <!-- PRODUCTOS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Productos comprados"
                    android:textColor="#6A4C93"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- LOS PRODUCTOS SE CREARÁN DESDE KOTLIN -->

                <LinearLayout
                    android:id="@+id/contenedorProductosDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- INFORMACIÓN DE ENTREGA -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información de entrega"
                    android:textColor="#6A4C93"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtDetalleDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Dirección de entrega"
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtDetalleMetodoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Método de pago"
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtDetalleEstadoPago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pago pendiente"
                    android:textColor="#C08400"
                    android:textSize="14sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RESUMEN ECONÓMICO -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen del pedido"
                    android:textColor="#6A4C93"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtDetalleSubtotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Subtotal: $0"
                    android:textColor="#555555"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtDetalleEnvio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Envío: Por calcular"
                    android:textColor="#777777"
                    android:textSize="14sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#EEE5F3"/>

                <TextView
                    android:id="@+id/txtDetalleTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total provisional: $0"
                    android:textColor="#6A4C93"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CANCELACIÓN DEL COMPRADOR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPedidoCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cancelar pedido"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#C62828"
            app:cornerRadius="12dp"/>

        <TextView
            android:id="@+id/txtAvisoCancelacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Solo puedes cancelar mientras el pedido esté pendiente."
            android:textColor="#777777"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>
