<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:id="@+id/layoutEncabezado"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFF7FA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/flecha_pequena_izquierda"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ubicación de entrega"
            android:textColor="#6A4C93"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Space
            android:layout_width="32dp"
            android:layout_height="32dp"/>

    </LinearLayout>

    <!-- MAPA INTERACTIVO -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapContainer"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutEncabezado"
        app:layout_constraintBottom_toTopOf="@id/layoutInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PANEL INFERIOR -->
    <LinearLayout
        android:id="@+id/layoutInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tu ubicación de entrega"
            android:textColor="#6A4C93"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDireccionSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toca el mapa para seleccionar un lugar"
            android:textColor="#666666"
            android:textSize="14sp"/>

        <!-- OBTENER UBICACIÓN ACTUAL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUbicacionActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Usar mi ubicación actual"
            android:textColor="#6A4C93"
            app:backgroundTint="#F0E8FA"
            app:cornerRadius="24dp"/>

        <!-- CONFIRMAR DIRECCIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarUbicacion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="Confirmar ubicación"
            android:textColor="#FFFFFF"
            android:enabled="false"
            app:backgroundTint="#9B7AE0"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
