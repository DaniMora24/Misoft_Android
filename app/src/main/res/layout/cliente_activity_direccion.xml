<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CABECERA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/flecha_pequena_izquierda"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Direcciones de envío"
                    android:textColor="#6A4C93"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <Space
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

            </LinearLayout>

            <!-- DIRECCIÓN CASA -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🏠 Casa"
                            android:textColor="#6A4C93"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/imgEditarCasa"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/lapiz"/>

                        <ImageView
                            android:id="@+id/imgEliminarCasa"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/basura_roja"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Cra 123 #45-67"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bogotá D.C."/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- DIRECCIÓN TRABAJO -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💼 Trabajo"
                            android:textColor="#6A4C93"
                            android:textStyle="bold"/>

                        <ImageView
                            android:id="@+id/imgEditarTrabajo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/lapiz"/>

                        <ImageView
                            android:id="@+id/imgEliminarTrabajo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/basura_roja"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Av. El Dorado #20-15"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bogotá D.C."/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- BOTÓN AGREGAR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarDireccion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Agregar dirección"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#9B7AE0"
                app:cornerRadius="28dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@null"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
