<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#FFF7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- INDICADOR SUPERIOR -->

        <View
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#D3D3D3"/>

        <TextView
            android:id="@+id/txtTituloProductoAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Detalle del producto"
            android:textColor="#6A4C93"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- IMAGEN REAL DEL PRODUCTO -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/imgProductoAdmin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_michigurumis_final"
                android:contentDescription="Imagen del producto"/>

        </androidx.cardview.widget.CardView>

        <!-- NOMBRE -->

        <TextView
            android:id="@+id/txtNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre del producto"
            android:textColor="#6A4C93"
            android:textSize="23sp"
            android:textStyle="bold"/>

        <!-- PRECIO -->

        <TextView
            android:id="@+id/txtPrecioProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="$ —"
            android:textColor="#D46AA7"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- ESTADO -->

        <TextView
            android:id="@+id/txtEstadoProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estado: —"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <!-- DESCRIPCIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Descripción"
            android:textColor="#6A4C93"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDescripcionProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sin descripción disponible."
            android:textColor="#555555"
            android:textSize="14sp"/>

        <!-- INFORMACIÓN DEL PRODUCTO -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información del producto"
                    android:textColor="#6A4C93"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtStockProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📦 Stock: —"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/txtStockMinimoProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⚠️ Stock mínimo: —"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/txtTallaProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📏 Talla: —"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/txtVendedorProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🏪 Vendedor: —"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/txtCategoriaProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🏷️ Categoría: —"
                    android:textColor="#555555"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- VENTAS REGISTRADAS -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estadísticas de ventas"
                    android:textColor="#6A4C93"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtVentasProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🛒 Unidades vendidas: —"
                    android:textColor="#555555"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- CONTROL DE VISIBILIDAD -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOcultarProducto"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="Ocultar producto"
            android:textColor="#FFFFFF"
            app:backgroundTint="#8E6AD8"
            app:cornerRadius="27dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="La visibilidad afecta al catálogo, no elimina el historial de ventas."
            android:textColor="#999999"
            android:textSize="12sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

    </LinearLayout>

</ScrollView>
