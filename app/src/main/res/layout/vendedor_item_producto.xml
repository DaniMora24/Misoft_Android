<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@drawable/usuario"
            android:contentDescription="Imagen del producto"/>

        <!-- Información del producto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del producto"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"/>

            <TextView
                android:id="@+id/txtPrecioItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$45.000"
                android:textColor="#5D3FD3"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtStockItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Stock: 0"
                android:textColor="#666666"
                android:textSize="13sp"/>



            <!-- Estado del inventario -->
            <TextView
                android:id="@+id/txtEstadoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#DDF5E1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="En stock"
                android:textColor="#2E7D32"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Toca la imagen para la vista previa"
                android:textColor="#666666"
                android:textSize="10sp"/>

        </LinearLayout>

        <!-- Acciones -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Editar -->
            <ImageView
                android:id="@+id/imgEditarProducto"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:padding="3dp"
                android:src="@drawable/lapiz"
                android:contentDescription="Editar producto"
                android:clickable="true"
                android:focusable="true"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content"/>

                <!--Estado Producto -->
            <ImageView
                android:id="@+id/imgEstadoProducto"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:padding="3dp"
                android:src="@drawable/desactivar_producto"
                android:contentDescription="Desactivar producto"
                android:clickable="true"
                android:focusable="true"/>


        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
