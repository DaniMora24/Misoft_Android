<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Barra superior -->

    <View
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:background="#D3D3D3"/>

    <!-- Título -->

    <TextView
        android:id="@+id/txtTituloPse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Agregar cuenta PSE"
        android:textColor="#6A4C93"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <!-- Banco -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Banco"
        android:textColor="#6A4C93"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <AutoCompleteTextView
            android:id="@+id/actBanco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccione un banco"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Tipo Persona -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tipo de persona"
        android:textColor="#6A4C93"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/radioGroupPersona"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbNatural"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Natural"/>

        <RadioButton
            android:id="@+id/rbJuridica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jurídica"/>

    </RadioGroup>

    <!-- Correo -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Correo Electrónico"
        android:textColor="#6A4C93"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCorreoPse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="correo@email.com"
            android:inputType="textEmailAddress"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Alias -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Alias"
        android:textColor="#6A4C93"
        android:textStyle="bold"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtAliasPse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Bancolombia Principal"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarPse"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Guardar cuenta"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#9B7AE0"
        app:cornerRadius="28dp"/>

</LinearLayout>