<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Indicador -->

        <View
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#D3D3D3"/>

        <!-- Título -->

        <TextView
            android:id="@+id/txtTituloProductoAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Detalle Producto"
            android:textColor="#6A4C93"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- Imagen -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp">

            <ImageView
                android:id="@+id/imgProductoAdmin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/naruto"/>

        </androidx.cardview.widget.CardView>

        <!-- Información principal -->

        <TextView
            android:id="@+id/txtNombreProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Naruto Amigurumi"
            android:textColor="#6A4C93"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtPrecioProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$55.000"
            android:textColor="#D46AA7"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- Estado -->

        <TextView
            android:id="@+id/txtEstadoProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✅ Visible"
            android:textColor="#4CAF50"
            android:textStyle="bold"/>

        <!-- Descripción -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Descripción"
            android:textColor="#6A4C93"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDescripcionProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amigurumi tejido a mano inspirado en personajes anime."/>

        <!-- Información -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtStockProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 Stock: 12"/>

                <TextView
                    android:id="@+id/txtVendedorProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🏪 Vendedor: Cristian Crochet"/>

                <TextView
                    android:id="@+id/txtCategoriaProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🏷 Categoría: Anime"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Estadísticas -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Estadísticas"
            android:textColor="#6A4C93"
            android:textStyle="bold"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtVisualizaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁 Visualizaciones: 143"/>

                <TextView
                    android:id="@+id/txtVentasProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🛒 Ventas: 28"/>

                <TextView
                    android:id="@+id/txtCalificacionProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="⭐ Calificación: 4.9"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botones Admin -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOcultarProducto"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Ocultar"
                android:textColor="#FFFFFF"
                app:backgroundTint="#FF9800"
                app:cornerRadius="28dp"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarProducto"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Eliminar"
                android:textColor="#FFFFFF"
                app:backgroundTint="#E53935"
                app:cornerRadius="28dp"/>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

    </LinearLayout>

</ScrollView>