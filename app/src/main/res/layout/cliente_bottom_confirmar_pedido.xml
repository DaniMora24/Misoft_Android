<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- BARRA SUPERIOR -->
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#E0D4EC"/>

        <!-- ENCABEZADO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Confirmar pedido"
            android:textColor="#6A4C93"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Revisa los detalles antes de finalizar tu compra"
            android:textColor="#888888"
            android:textSize="13sp"/>

        <!-- RESUMEN DE COMPRA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#FFF7FA"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen de compra"
                    android:textColor="#6A4C93"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <!-- SUBTOTAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Productos"
                        android:textColor="#666666"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txtResumenProductos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- ENVÍO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Envío"
                        android:textColor="#666666"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por calcular"
                        android:textColor="#888888"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="#EADBE7"/>

                <!-- TOTAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total provisional"
                        android:textColor="#6A4C93"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtTotalProvisional"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0"
                        android:textColor="#8E6AD8"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- DIRECCIÓN DE ENTREGA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dirección de entrega"
            android:textColor="#6A4C93"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="#8E6AD8"
            app:hintTextColor="#8E6AD8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDireccionEntrega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dirección completa"
                android:inputType="textPostalAddress|textMultiLine"
                android:minLines="2"
                android:maxLines="3"
                android:textColor="#333333"
                android:textSize="14sp"/>

        </com.google.android.material.textfield.TextInputLayout>


        <!-- SELECCIONAR DIRECCIÓN GUARDADA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElegirDireccion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Seleccionar dirección guardada"
            android:textAllCaps="false"
            android:textColor="#8E6AD8"
            android:textStyle="bold"
            app:backgroundTint="#F3EAFE"
            app:cornerRadius="16dp"/>

        <!-- ADMINISTRAR DIRECCIONES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdministrarDirecciones"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Agregar o administrar direcciones"
            android:textAllCaps="false"
            android:textColor="#8E6AD8"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="16dp"/>


        <!-- MÉTODO DE PAGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Método de pago"
            android:textColor="#6A4C93"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#F5F0FD"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pago contraentrega"
                    android:textColor="#6A4C93"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@android:drawable/checkbox_on_background"
                    android:tint="#8E6AD8"
                    android:contentDescription="Método seleccionado"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- INFORMACIÓN DEL PAGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Pagarás cuando recibas tu pedido. El costo de envío aún está pendiente de calcular."
            android:textColor="#777777"
            android:textSize="12sp"/>

        <!-- CONFIRMAR PEDIDO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="Confirmar pedido"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#8E6AD8"
            app:cornerRadius="28dp"/>

        <!-- CANCELAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarPedido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textColor="#8E6AD8"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

    </LinearLayout>

</ScrollView>
