<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Se Agrega un NestedScrollView para permitir el desplazamiento del contenido -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/flecha_pequena_izquierda"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Detalle producto"
            android:textColor="#6A4C93"
            android:textStyle="bold"
            android:textSize="22sp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCarrito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/carrito_de_compras"
            app:backgroundTint="#9B7AE0"
            app:tint="#FFFFFF"
            app:fabCustomSize="40dp" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgProducto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/naruto"/>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:padding="5dp"
                android:background="@drawable/circulo_blanco"
                android:src="@drawable/corazon"/>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Naruto Amigurumi"
        android:textColor="#6A4C93"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$55.000"
        android:textColor="#D46AA7"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★★★★★ 4.9 (26)"
        android:textColor="#F9A825"
        android:textSize="14sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Descripción"
        android:textStyle="bold"
        android:textColor="#6A4C93"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amigurumi tejido a mano inspirado en personajes de anime. Elaborado con materiales suaves e hipoalergénicos."
        android:textColor="#555555"/>


    <!--chips de producto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Altura -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="35dp"
                        android:src="@drawable/altura"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Altura"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtAltura"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 cm"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Material -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="35dp"
                        android:src="@drawable/lana_material"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Material"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtMaterial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hilo de algodón"
                            android:textColor="#888888"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    <!-- Disponibilidad en stock-->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="✅ Stock disponible: 12 Unidades"
        android:textColor="#4CAF50"
        android:textStyle="bold"/>


        <!--Selectror de cantidad-->

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/selector_cantidad"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Botón Restar -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMenos"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="-"
                android:textColor="#7D6BB2"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Divisor -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#A6A6A6" />

            <!-- Cantidad -->
            <TextView
                android:id="@+id/txtCantidad"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="#000000"
                android:textSize="16sp" />

            <!-- Divisor -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#A6A6A6" />

            <!-- Botón Sumar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSumar"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:text="+"
                android:textColor="#7D6BB2"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Agregar al carrito"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#9B7AE0"
            app:cornerRadius="28dp"
            app:icon="@drawable/carrito_agregar"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
