<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- UBICACIÓN PARA GOOGLE MAPS -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisoftApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- SPLASH -->
        <activity
            android:name=".auth.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AUTENTICACIÓN -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".auth.ForgetPassword"
            android:exported="false" />

        <!-- HOME -->
        <activity
            android:name=".home.HomeBuyerActivity"
            android:exported="false" />

        <!-- CATÁLOGO -->
        <activity
            android:name=".catalogo.CatalogoActivity"
            android:exported="false" />

        <activity
            android:name=".catalogo.FavoritosActivity"
            android:exported="false" />

        <activity
            android:name=".catalogo.DetalleProductoActivity"
            android:exported="false" />

        <!-- CARRITO Y COMPRAS -->
        <activity
            android:name=".compras.CarritoActivity"
            android:exported="false" />

        <activity
            android:name=".compras.DetalleCompraActivity"
            android:exported="false" />

        <activity
            android:name=".compras.ComprasActivity"
            android:exported="false" />

        <!-- PERFIL DEL COMPRADOR -->
        <activity
            android:name=".perfil_cliente.PerfilClienteActivity"
            android:exported="false" />

        <activity
            android:name=".perfil_cliente.PersonalInfoActivity"
            android:exported="false" />

        <activity
            android:name=".perfil_cliente.MetodoPagoActivity"
            android:exported="false" />

        <activity
            android:name=".perfil_cliente.DireccionActivity"
            android:exported="false" />


        <activity
            android:name=".perfil_cliente.AyudaContactoActivity"
            android:exported="false" />


        <!-- UBICACIÓN DE ENTREGA -->
        <activity
            android:name=".perfil_cliente.UbicacionActivity"
            android:exported="false" />

        <!-- VENDEDOR -->
        <activity
            android:name=".home.HomeVendedorActivity"
            android:exported="false" />

        <activity
            android:name=".estadisticas.EstadisticasVendedorActivity"
            android:exported="false" />

        <activity
            android:name=".catalogo.ProductosVendedorActivity"
            android:exported="false" />

        <activity
            android:name=".pedidos.GestionPedidosActivity"
            android:exported="false" />

        <activity
            android:name=".perfil_vendedor.PerfilVendedorActivity"
            android:exported="false" />

        <!-- ADMINISTRADOR -->
        <activity
            android:name=".home.HomeAdminActivity"
            android:exported="false" />

        <activity
            android:name=".usuarios.UsuariosAdminActivity"
            android:exported="false" />

        <activity
            android:name=".usuarios.VendedoresAdminActivity"
            android:exported="false" />

        <activity
            android:name=".catalogo.ProductoAdminActivity"
            android:exported="false" />

        <activity
            android:name=".estadisticas.ReportesAdminActivity"
            android:exported="false" />

    </application>

</manifest>
